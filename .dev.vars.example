# Local secrets for `wrangler dev` — copy to `.dev.vars` (gitignored) and fill in.
# In production these are set with `wrangler secret put <NAME>` instead, one at a time.

JWT_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=change-me-now

# Stripe (test mode). Blank is fine — checkout stays disabled until these are set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
