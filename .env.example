# Copy to .env and fill in.  The site runs without Stripe keys, but checkout is
# disabled until STRIPE_SECRET_KEY is set.

# --- Admin login -----------------------------------------------------------
ADMIN_EMAIL=admin@aromasense.local
ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-string

# --- App -----------------------------------------------------------------
API_PORT=8787
APP_URL=http://localhost:5177

# --- Stripe (test mode) -------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# `stripe listen --forward-to localhost:8787/api/webhooks/stripe` prints this
STRIPE_WEBHOOK_SECRET=
